{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["vitest/config"],
    "outDir": "dist/tsbuild-node"
  },
  "include": ["vite.config.ts"]
}
